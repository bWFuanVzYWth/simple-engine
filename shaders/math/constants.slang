public static const let tau : float = 6.28318530717958647692;
public static const let frac_1_pi : float = 0.31830988618379067154;
public static const let frac_1_tau : float = 0.15915494309189533577;
public static const let frac_1_4_pi : float = 0.07957747154594766788;
public static const let frac_pi_2 : float = 1.57079632679489661923;
public static const let frac_1_sqrt_2 : float = 0.70710678118654752440;
}
